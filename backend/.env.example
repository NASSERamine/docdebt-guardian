# Copy to .env and fill in real values. Never commit .env.
#
# Source them into your shell before starting the service:
#   set -a && source .env && set +a
#   uvicorn docdebt.service.app:create_app --factory --reload

# From your GitHub App's "General" page (the numeric App ID, not the Client ID)
DOCDEBT_GITHUB_APP_ID=

# Either point at the downloaded .pem file...
DOCDEBT_GITHUB_PRIVATE_KEY_PATH=/home/you/.docdebt-secrets/docdebt-app.pem
# ...or paste the key contents directly (useful in production where a file
# path is less convenient than a secret manager). Only one of the two is read;
# the path above takes priority when both are set.
# DOCDEBT_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# From your GitHub App's "General" page, Webhook secret (openssl rand -hex 32)
DOCDEBT_GITHUB_WEBHOOK_SECRET=

# Repair/detection model. A local Ollama model by default; must be reachable
# at the OLLAMA base URL configured in the model catalog (docdebt.llm.catalog).
DOCDEBT_REPAIR_MODEL=qwen2.5-coder:7b
DOCDEBT_REPAIR_PATTERN=zeroshot

# true (default): structural checks only, no LLM detection call, cheapest and
# most predictable. false: also runs the Judge for semantic debt.
DOCDEBT_STRUCTURAL_ONLY=true

# Where this process keeps its own state. Both are plain SQLite files; back
# them up together if you care about not losing pending reviews.
DOCDEBT_STATE_DB=.docdebt-service/state.sqlite3
DOCDEBT_GRAPH_DB=.docdebt-service/graph.sqlite3
